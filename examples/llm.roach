#!/usr/bin/env roach

/*
   This program run a LLM/GPT model

   To run, first create a .env file as for example (LLM.env):

   -----------------------------------------------------------------------
   OLLAMA_HOST=http://ia.labqs.ita.br:11434
   OLLAMA_MODEL=hf.co/ibm-granite/granite-4.0-h-small-GGUF:latest
   -----------------------------------------------------------------------

   Now run with:

   -----------------------------------------------------------------------
   roach -e LLM.env llm.roach
   -----------------------------------------------------------------------

*/

let gpt = llmConnect()

println("============ Connection data ====================================")
println("Host: ", gpt.host)
println("Model: ", gpt.model)

println("========== Context Parameters ===================================")
println("CtxSize: ", gpt.ctxSize)
println("NumGPU: ", gpt.numGPU)
println("NumBatch: ", gpt.numBatch)

println("========= Inference Parameters ==================================")
println("Temperature: ", gpt.temperature)
println("NumThread: ", gpt.numThread)
println("NumPredict: ", gpt.numPredict)
println("RepeatPenalty: ", gpt.repeatPenalty)
println("=================================================================")

gpt.setSystemCard("Você é um assistente literário muito detalhista.")

let question = "Qual a questão cuja resposta seja 42?"

let answer = gpt.generate(question)

println("Question: ", question)
println("Answer: ", answer)
println("=================================================================")

gpt.resetContext()
gpt.setModel("llama2")

println("============ Connection data ====================================")
println("Host: ", gpt.host)
println("Model: ", gpt.model)
println("=================================================================")

gpt.setSystemCard("Agora você é um assistente literário muito relapso e breve em suas respostas. Responsa sempre em lingua portuguesa!")

let answer = gpt.generate(question)

println("Question: ", question)
println("Answer: ", answer)
println("=================================================================")
